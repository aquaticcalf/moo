FROM ubuntu:24.04

ARG ODIN_RELEASE=dev-2026-07a

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
        gcc \
        g++ \
        gnupg \
        make \
        mingw-w64 \
        tar \
    && curl --fail --location https://apt.llvm.org/llvm-snapshot.gpg.key \
        | gpg --dearmor --output /etc/apt/trusted.gpg.d/llvm.gpg \
    && echo "deb http://apt.llvm.org/noble/ llvm-toolchain-noble-20 main" \
        > /etc/apt/sources.list.d/llvm.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        clang-20 \
        llvm-20 \
        llvm-20-dev \
        lld-20 \
        liblld-20-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 5 --show-error \
        "https://github.com/odin-lang/Odin/releases/download/${ODIN_RELEASE}/odin-linux-amd64-${ODIN_RELEASE}.tar.gz" \
        --output /tmp/odin.tar.gz \
    && mkdir --parents /opt/odin \
    && tar --extract --gzip \
        --file /tmp/odin.tar.gz \
        --strip-components=1 \
        --directory /opt/odin \
    && rm /tmp/odin.tar.gz

ENV ODIN_ROOT=/opt/odin
ENV PATH=/opt/odin:/usr/lib/llvm-20/bin:${PATH}

WORKDIR /workspace
