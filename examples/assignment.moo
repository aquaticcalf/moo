# a six person mission to the orbital station, fourteen days long
crew is 6
days is 14

# everyone needs three liters of water and two units of food per day
water_per_day is 3
food_per_day is 2

# totals for the whole crew over the whole mission
water_needed is water_per_day * crew * days
food_needed is food_per_day * crew * days

show crew
show days
show water_needed
show food_needed
